generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         String                  @id @default(cuid())
  name                       String
  email                      String?                 @unique
  emailVerified              DateTime?
  phone                      String                  @unique
  password                   String?
  image                      String?
  role                       UserRole                @default(FARMER)
  region                     String?
  district                   String?
  isActive                   Boolean                 @default(true)
  ghanaCardNumber            String?                 @unique
  ghanaCardName              String?
  residenceLocation          String?
  isVerified                 Boolean                 @default(false)
  verifiedAt                 DateTime?
  // Add-on capability alongside `role` (mirrors isVerified's plumbing) — an
  // existing Farmer/Buyer/Logistics/Storage Facility user can also join the
  // Incident Team without losing their primary role/dashboard.
  isIncidentTeam             Boolean                 @default(false)
  latitude                   Float?
  longitude                  Float?
  lastSeen                   DateTime?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  accounts                   Account[]
  buyerProfile               BuyerProfile?
  complaints                 Complaint[]             @relation("UserComplaints")
  events                     UserEvent[]
  recommendations            Recommendation[]
  farmerProfile              FarmerProfile?
  following                  Follow[]                @relation("UserFollowing")
  followers                  Follow[]                @relation("UserFollowers")
  logisticsProfile           LogisticsProfile?
  receivedMessages           Message[]               @relation("ReceivedMessages")
  sentMessages               Message[]               @relation("SentMessages")
  sentNotifs                 Notification[]          @relation("NotificationActor")
  notifications              Notification[]          @relation("NotificationRecipient")
  buyerOrders                Order[]                 @relation("BuyerOrders")
  farmerOrders               Order[]                 @relation("FarmerOrders")
  buyerOffers                Offer[]                 @relation("BuyerOffers")
  farmerOffers               Offer[]                 @relation("FarmerOffers")
  listings                   ProduceListing[]
  reviewsGiven               Review[]                @relation("ReviewAuthor")
  reviewsReceived            Review[]                @relation("ReviewTarget")
  sessions                   Session[]
  transportRequests          TransportRequest[]
  storageFacilityProfile     StorageFacilityProfile?
  storageBookings            StorageBooking[]
  verificationRequests       VerificationRequest[]   @relation("VerificationApplicant")
  verificationReviews        VerificationRequest[]   @relation("VerificationReviewer")
  adminRequest               AdminRequest?           @relation("AdminRequestApplicant")
  adminRequestReviews        AdminRequest[]          @relation("AdminRequestReviewer")
  incidentTeamRequest        IncidentTeamRequest?    @relation("IncidentTeamApplicant")
  incidentTeamRequestReviews IncidentTeamRequest[]   @relation("IncidentTeamReviewer")
  assignedComplaints         Complaint[]             @relation("ComplaintAssignee")
  targetedComplaints         Complaint[]             @relation("ComplaintTarget")
  resolvedComplaints         Complaint[]             @relation("ComplaintResolver")
}

model FarmerProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  farmName     String
  farmSize     Float?
  description  String?
  location     String
  latitude     Float?
  longitude    Float?
  rating       Float    @default(0)
  totalRatings Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  acceptsCOD   Boolean  @default(true)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BuyerProfile {
  id           String    @id @default(cuid())
  userId       String    @unique
  businessName String?
  businessType BuyerType @default(HOUSEHOLD)
  description  String?
  rating       Float     @default(0)
  totalRatings Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LogisticsProfile {
  id                String             @id @default(cuid())
  userId            String             @unique
  companyName       String?
  vehicleType       VehicleType
  vehicleCapacity   Float?
  licensePlate      String?
  coverageAreas     String[]
  isAvailable       Boolean            @default(true)
  rating            Float              @default(0)
  totalRatings      Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transportRequests TransportRequest[]
  deliveryLegs      DeliveryLeg[]
}

model ProduceListing {
  id                String                  @id @default(cuid())
  // Monotonic push-counter — guarantees a true LIFO order for the marketplace feed
  // even when many rows share the same createdAt (e.g. bulk-seeded data), which
  // createdAt alone can't break ties on deterministically.
  sequence          Int                     @default(autoincrement())
  farmerId          String
  cropType          String
  category          ProduceCategory
  quantity          Float
  unit              String
  pricePerUnit      Float
  currency          String                  @default("GHS")
  description       String?
  images            String[]
  harvestDate       DateTime?
  expiryDate        DateTime?
  location          String
  latitude          Float?
  longitude         Float?
  status            ListingStatus           @default(ACTIVE)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  approvalNotes     String?
  approvalStatus    ApprovalStatus          @default(PENDING)
  // Set when pricePerUnit deviates sharply from the category's recent median —
  // surfaces the listing for priority admin review even if it auto-approved.
  priceFlagged      Boolean                 @default(false)
  // Set only once a storage-facility operator marks the matching StorageBooking
  // DROPPED_OFF — null means the farmer is holding/selling this produce directly,
  // unchanged from the original flow.
  storageFacilityId String?
  orders            Order[]
  farmer            User                    @relation(fields: [farmerId], references: [id])
  storageFacility   StorageFacilityProfile? @relation(fields: [storageFacilityId], references: [id])
  storageBookings   StorageBooking[]
  messages          Message[]
  offers            Offer[]
}

model Order {
  id                       String                  @id @default(cuid())
  buyerId                  String
  farmerId                 String
  listingId                String
  quantity                 Float
  totalAmount              Float
  status                   OrderStatus             @default(PENDING)
  paymentStatus            PaymentStatus           @default(UNPAID)
  fulfillmentType          OrderFulfillment        @default(DELIVERY)
  notes                    String?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  deliveryNumber           String?                 @unique
  // Snapshotted from the listing at order-creation time — bookkeeping only, no
  // real money-split happens (see Payment/paystack.ts: a single platform-account
  // charge, same as every other order). null = produce wasn't facility-routed.
  storageFacilityId        String?
  facilityCommissionRate   Float?
  facilityCommissionAmount Float?
  buyer                    User                    @relation("BuyerOrders", fields: [buyerId], references: [id])
  farmer                   User                    @relation("FarmerOrders", fields: [farmerId], references: [id])
  listing                  ProduceListing          @relation(fields: [listingId], references: [id])
  storageFacility          StorageFacilityProfile? @relation(fields: [storageFacilityId], references: [id])
  payment                  Payment?
  transportRequest         TransportRequest?
  offer                    Offer?
}

enum OfferStatus {
  PENDING
  COUNTERED
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum OfferParty {
  BUYER
  FARMER
}

// A structured, binding negotiation over a listing's price/quantity — each
// row holds the CURRENT terms on the table; a counter overwrites quantity/
// price in place rather than appending a new row, so there's always exactly
// one live offer per buyer-listing pair to accept, counter, or reject.
model Offer {
  id           String         @id @default(cuid())
  listingId    String
  buyerId      String
  farmerId     String
  quantity     Float
  pricePerUnit Float
  message      String?
  status       OfferStatus    @default(PENDING)
  // Whoever proposed the CURRENT quantity/price — the other party is the only
  // one who can accept, counter, or reject it (prevents a buyer from
  // "accepting" their own still-pending offer, and vice versa).
  lastActionBy OfferParty
  expiresAt    DateTime
  orderId      String?        @unique
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  listing      ProduceListing @relation(fields: [listingId], references: [id])
  buyer        User           @relation("BuyerOffers", fields: [buyerId], references: [id])
  farmer       User           @relation("FarmerOffers", fields: [farmerId], references: [id])
  order        Order?         @relation(fields: [orderId], references: [id])

  @@index([listingId])
  @@index([buyerId])
  @@index([farmerId])
}

model Payment {
  id        String        @id @default(cuid())
  orderId   String        @unique
  amount    Float
  currency  String        @default("GHS")
  method    PaymentMethod @default(MOBILE_MONEY)
  reference String?       @unique
  status    PaymentStatus @default(UNPAID)
  momoPhone String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  order     Order         @relation(fields: [orderId], references: [id])
}

model TransportRequest {
  id                    String            @id @default(cuid())
  orderId               String?           @unique
  requesterId           String
  providerId            String?
  pickupLocation        String
  pickupLat             Float?
  pickupLong            Float?
  deliveryLocation      String
  deliveryLat           Float?
  deliveryLong          Float?
  scheduledDate         DateTime
  estimatedCost         Float?
  actualCost            Float?
  status                TransportStatus   @default(PENDING)
  paymentMethod         PaymentMethod?
  paymentStatus         PaymentStatus     @default(UNPAID)
  paymentReference      String?           @unique
  notes                 String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  rejectedByRiders      String[]          @default([])
  weightKg              Float?
  estimatedDeliveryDate DateTime?
  order                 Order?            @relation(fields: [orderId], references: [id])
  provider              LogisticsProfile? @relation(fields: [providerId], references: [id])
  requester             User              @relation(fields: [requesterId], references: [id])
  legs                  DeliveryLeg[]
}

// One row per rider who has handled a leg of a (possibly relayed) delivery —
// lets a farmer chain 3-4 riders on one TransportRequest for safer long-haul
// coordination, while TransportRequest.providerId always reflects who currently
// has custody of the produce.
model DeliveryLeg {
  id                 String           @id @default(cuid())
  transportRequestId String
  providerId         String
  sequence           Int
  status             TransportStatus  @default(ASSIGNED)
  startedAt          DateTime         @default(now())
  endedAt            DateTime?
  handoffNote        String?
  transportRequest   TransportRequest @relation(fields: [transportRequestId], references: [id], onDelete: Cascade)
  provider           LogisticsProfile @relation(fields: [providerId], references: [id])

  @@unique([transportRequestId, sequence])
}

model Message {
  id         String          @id @default(cuid())
  senderId   String
  receiverId String
  content    String
  read       Boolean         @default(false)
  createdAt  DateTime        @default(now())
  // Set only when the message was started from a marketplace listing (e.g. the
  // "Message Farmer" quick-contact dialog) — gives the conversation crop/price
  // context. Messages sent from the plain messaging inbox leave this null.
  listingId  String?
  listing    ProduceListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  receiver   User            @relation("ReceivedMessages", fields: [receiverId], references: [id])
  sender     User            @relation("SentMessages", fields: [senderId], references: [id])
}

model Review {
  id        String          @id @default(cuid())
  authorId  String
  targetId  String
  orderId   String?
  orderType ReviewOrderType @default(ORDER)
  rating    Int
  comment   String?
  createdAt DateTime        @default(now())
  author    User            @relation("ReviewAuthor", fields: [authorId], references: [id])
  target    User            @relation("ReviewTarget", fields: [targetId], references: [id])

  @@unique([authorId, orderId, targetId])
}

// One row per (order, reviewer, target) — created when an order/delivery is
// completed so the review page knows exactly who still owes a review to whom,
// without re-deriving it from order relations every time.
model ReviewRequest {
  id         String          @id @default(cuid())
  orderType  ReviewOrderType @default(ORDER)
  orderId    String
  userId     String
  targetId   String
  targetRole UserRole
  completed  Boolean         @default(false)
  createdAt  DateTime        @default(now())

  @@unique([orderId, userId, targetId])
}

enum ReviewOrderType {
  ORDER
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone])
}

// One row per login attempt — lets us rate-limit/lock out a phone number
// after repeated failures within a sliding window, independent of whether
// the account actually exists (avoids leaking account existence via timing).
model LoginAttempt {
  id        String   @id @default(cuid())
  phone     String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
}

// A physical produce storage site (cold-chain and/or hermetic/dry storage) that
// a farmer can book a drop-off slot at instead of selling directly. See
// StorageBooking for the drop-off lifecycle and Order.storageFacilityId for how
// a sale routed through a facility is recorded.
model StorageFacilityProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  name               String
  description        String?
  location           String
  latitude           Float?
  longitude          Float?
  storageTypes       StorageType[]
  capacityTonnes     Float?
  acceptedCategories ProduceCategory[]
  // Equipment a facility advertises to farmers/buyers — feeds directly into the
  // AI facility recommendation (see AiInsightSubject.FACILITY_RECOMMENDATION).
  equipment          StorageEquipment[]
  operatingHours     String?
  rating             Float              @default(0)
  totalRatings       Int                @default(0)
  // Mirrors ProduceListing's admin moderation gate — a facility only appears
  // on the farmer-facing map once approved.
  approvalStatus     ApprovalStatus     @default(PENDING)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings           StorageBooking[]
  listings           ProduceListing[]
  orders             Order[]
}

// A farmer's request to drop harvested produce off at a facility. Deliberately
// decoupled from ProduceListing until drop-off — a farmer can book a slot
// before a sellable listing exists, and this avoids the same physical harvest
// being listed both directly and via a facility at once.
model StorageBooking {
  id               String                 @id @default(cuid())
  facilityId       String
  farmerId         String
  listingId        String?
  cropType         String
  category         ProduceCategory
  quantity         Float
  unit             String
  pricePerUnit     Float
  scheduledDropoff DateTime
  status           StorageBookingStatus   @default(PENDING)
  facilityNotes    String?
  confirmedAt      DateTime?
  droppedOffAt     DateTime?
  returnedAt       DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  facility         StorageFacilityProfile @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  farmer           User                   @relation(fields: [farmerId], references: [id])
  listing          ProduceListing?        @relation(fields: [listingId], references: [id])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  actorId   String?
  type      String
  title     String
  body      String
  link      String?
  entityId  String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  actor     User?    @relation("NotificationActor", fields: [actorId], references: [id])
  user      User     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
}

model Recommendation {
  id       String   @id @default(cuid())
  userId   String?
  phone    String
  message  String
  listings Json
  sentAt   DateTime @default(now())
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([sentAt])
}

// A cached AI-generated tip, one row per subject (upserted, not an append-only
// log like Recommendation) — regenerated when stale (see src/lib/ai-insights.ts)
// since nothing in this app caches LLM output today and every existing call
// path hits OpenRouter fresh on every request.
model AiInsight {
  id          String           @id @default(cuid())
  subjectType AiInsightSubject
  subjectId   String
  content     String
  generatedAt DateTime         @default(now())

  @@unique([subjectType, subjectId])
}

enum AiInsightSubject {
  FACILITY_PRACTICES
  FARMER_LOSS_TIPS
  FACILITY_RECOMMENDATION
}

model VerificationRequest {
  id                String         @id @default(cuid())
  userId            String
  role              UserRole
  ghanaCardNumber   String
  ghanaCardName     String
  residenceLocation String
  idPhotoFront      String
  idPhotoBack       String?
  status            ApprovalStatus @default(PENDING)
  reviewNotes       String?
  reviewedById      String?
  reviewedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  user              User           @relation("VerificationApplicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy        User?          @relation("VerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

// Gates initial access for anyone who registers directly as ADMIN — unlike
// VerificationRequest this isn't a paid optional badge, it's a hard requirement
// before the account can use any admin feature at all.
model AdminRequest {
  id              String         @id @default(cuid())
  userId          String         @unique
  ghanaCardNumber String
  ghanaCardName   String
  idPhotoFront    String
  idPhotoBack     String?
  status          ApprovalStatus @default(PENDING)
  reviewNotes     String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  user            User           @relation("AdminRequestApplicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy      User?          @relation("AdminRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])
}

// An existing, already-active user applying to join the Incident Team
// ("Macho Men Association") — unlike AdminRequest this doesn't gate the
// account itself (the applicant keeps full normal access while pending), and
// doesn't re-collect Ghana Card info since it's already on User from their
// original registration. Approval sets User.isIncidentTeam, never role.
model IncidentTeamRequest {
  id           String         @id @default(cuid())
  userId       String         @unique
  reason       String?
  status       ApprovalStatus @default(PENDING)
  reviewNotes  String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  user         User           @relation("IncidentTeamApplicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   User?          @relation("IncidentTeamReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])
}

model UserEvent {
  id        String   @id @default(cuid())
  sessionId String
  userId    String?
  type      String
  data      Json
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Derived/materialized fields — promoted out of `data` for common keys so they're queryable
  // in SQL directly. `data` is kept as the full-fidelity source (also covers future/unlisted keys).
  ipFormatted String?
  placeName   String? // reverse-geocoded from lat/lon, filled in asynchronously after write
  os          String?
  deviceType  String?
  url         String?
  referrer    String?
  depth       Int?
  element     String?
  elementText String?
  href        String?
  trackId     String?
  accuracy    Float?
  lat         Float?
  lon         Float?

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model Complaint {
  id           String            @id @default(cuid())
  reporterId   String
  subject      String
  category     ComplaintCategory
  description  String
  status       ComplaintStatus   @default(OPEN)
  adminNotes   String?
  resolvedAt   DateTime?
  resolvedById String?
  // Optional — who this complaint is about, distinct from who filed it
  // (reporterId). Used to track repeat offenders; not every complaint has a
  // specific person in mind (e.g. a technical bug report), so this stays nullable.
  targetUserId String?
  // Optional — an Admin or Incident Team ("Macho Men Association") member
  // this complaint has been assigned to (by an admin) or self-assigned to.
  assignedToId String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  reporter     User              @relation("UserComplaints", fields: [reporterId], references: [id], onDelete: Cascade)
  target       User?             @relation("ComplaintTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  assignedTo   User?             @relation("ComplaintAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolvedBy   User?             @relation("ComplaintResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([targetUserId])
  @@index([assignedToId])
}

enum UserRole {
  FARMER
  BUYER
  LOGISTICS
  ADMIN
  STORAGE_FACILITY
}

// COLD_CHAIN: refrigerated storage for perishables (tomato, mango, watermelon,
// leafy veg). HERMETIC_DRY: PICS-bag-style airtight dry storage for grains and
// legumes (maize, sorghum, millet, rice, cowpea, soybean, groundnut). These are
// the two loss-reduction technologies the post-harvest-loss research actually
// documents — deliberately not a broader/vaguer list.
enum StorageType {
  COLD_CHAIN
  HERMETIC_DRY
}

// Physical equipment a facility can advertise, so farmers know what it's
// actually capable of before booking (e.g. a facility with REFRIGERATORS can
// hold perishables past what ambient HERMETIC_DRY storage allows).
enum StorageEquipment {
  REFRIGERATORS
  COOLERS
  DRYERS
  DRYING_PANS
  VENTILATION_FANS
  WEIGHING_SCALES
  PALLETS_RACKING
  BACKUP_GENERATOR
}

enum StorageBookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  DROPPED_OFF
  RETURNED_TO_FARMER
  CANCELLED
}

enum BuyerType {
  WHOLESALER
  RETAILER
  RESTAURANT
  PROCESSOR
  EXPORTER
  HOUSEHOLD
}

enum VehicleType {
  MOTORBIKE
  TRUCK
}

enum ProduceCategory {
  VEGETABLES
  GRAINS
  TUBERS
  FRUITS
  LEGUMES
  LIVESTOCK
}

enum ListingStatus {
  ACTIVE
  SOLD
  EXPIRED
  DRAFT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ComplaintCategory {
  FRAUD
  QUALITY_ISSUE
  DELIVERY_PROBLEM
  PAYMENT_DISPUTE
  HARASSMENT
  TECHNICAL
  OTHER
}

enum ComplaintStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum OrderFulfillment {
  PICKUP
  DELIVERY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY_FOR_PICKUP
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum PaymentMethod {
  MOBILE_MONEY
  CASH
  BANK_TRANSFER
}

enum TransportStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
}
