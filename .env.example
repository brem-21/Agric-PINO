# Database
DATABASE_URL="postgresql://user:password@localhost:5432/agrictech"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"

# Paystack (for MTN MoMo / Telecel Cash)
PAYSTACK_SECRET_KEY="sk_test_xxxxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxxxx"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxxxx"

# Cloudinary (media uploads)
# Get your URL at: https://console.cloudinary.com (Dashboard > Account Details)
CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OpenRouter (AI recommendations via OpenRouter — compatible with OpenAI SDK)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-your-key-here"

# mNotify (Ghana SMS gateway)
# Get your API key at: https://apps.mnotify.net
MNOTIFY_API_KEY="your-mnotify-api-key"
